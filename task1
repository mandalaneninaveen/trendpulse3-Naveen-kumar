# Search FAQs by keyword
def search_by_keyword(faqs, query):
    """Search FAQs and rank by matching query words."""
    results = []

    for faq in faqs:
        text = (faq["question"] + " " + faq["category"] +
                " " + " ".join(faq["keywords"])).lower()

        hits = sum(word in text for word in query.lower().split())

        if hits > 0:
            results.append((hits, faq))

    results.sort(key=lambda x: x[0], reverse=True)
    return [faq for hits, faq in results]


# Search FAQ by ID
def get_faq_by_id(faqs, faq_id):
    """Return FAQ by ID or None."""
    for faq in faqs:
        if faq["id"].lower() == faq_id.lower():
            return faq
    return None


# Search FAQs by category
def get_faqs_by_category(faqs, category):
    """Return FAQs matching a category."""
    return [faq for faq in faqs
            if faq["category"].lower() == category.lower()]


